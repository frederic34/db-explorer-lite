{
  "name": "db-explorer-lite",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.10.0",
  "publisher": "local",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/frederic34/db-explorer-lite.git"
  },
  "bugs": {
    "url": "https://github.com/frederic34/db-explorer-lite/issues"
  },
  "homepage": "https://github.com/frederic34/db-explorer-lite#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sql",
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "database"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbExplorer",
          "title": "%viewsContainers.activitybar.0.title%",
          "icon": "resources/database.svg"
        }
      ]
    },
    "views": {
      "dbExplorer": [
        {
          "id": "dbExplorer.connections",
          "name": "%views.dbExplorer.0.name%"
        },
        {
          "id": "dbExplorer.saved",
          "name": "%views.dbExplorer.1.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbExplorer.connections",
        "contents": "Aucune connexion configurée.\n[Ajouter une connexion](command:dbExplorer.addConnection)\n[Importer des connexions](command:dbExplorer.importConnections)"
      },
      {
        "view": "dbExplorer.saved",
        "contents": "Aucune requête enregistrée.\nDans un éditeur SQL : clic droit → Enregistrer la requête."
      }
    ],
    "commands": [
      {
        "command": "dbExplorer.addConnection",
        "title": "%commands.0.title%",
        "category": "DB Explorer",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.editConnection",
        "title": "%commands.1.title%",
        "category": "DB Explorer",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.removeConnection",
        "title": "%commands.2.title%",
        "category": "DB Explorer",
        "icon": "$(trash)"
      },
      {
        "command": "dbExplorer.refresh",
        "title": "%commands.3.title%",
        "category": "DB Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "dbExplorer.newQuery",
        "title": "%commands.4.title%",
        "category": "DB Explorer",
        "icon": "$(new-file)"
      },
      {
        "command": "dbExplorer.runQuery",
        "title": "%commands.5.title%",
        "category": "DB Explorer",
        "icon": "$(play)"
      },
      {
        "command": "dbExplorer.previewTable",
        "title": "%commands.6.title%",
        "category": "DB Explorer",
        "icon": "$(open-preview)"
      },
      {
        "command": "dbExplorer.showStructure",
        "title": "%commands.7.title%",
        "category": "DB Explorer",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "dbExplorer.showDiagram",
        "title": "%commands.8.title%",
        "category": "DB Explorer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbExplorer.setGroup",
        "title": "%commands.9.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.renameGroup",
        "title": "%commands.10.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.removeGroup",
        "title": "%commands.11.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.exportConnections",
        "title": "%commands.12.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.importConnections",
        "title": "%commands.13.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.selectConnection",
        "title": "%commands.14.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.copyName",
        "title": "%commands.15.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.history",
        "title": "%commands.16.title%",
        "category": "DB Explorer",
        "icon": "$(history)"
      },
      {
        "command": "dbExplorer.clearHistory",
        "title": "%commands.17.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.cancelQuery",
        "title": "%commands.18.title%",
        "category": "DB Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dbExplorer.forgetSshHosts",
        "title": "%commands.19.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.runStatement",
        "title": "%commands.20.title%",
        "category": "DB Explorer",
        "icon": "$(debug-start)"
      },
      {
        "command": "dbExplorer.explain",
        "title": "%commands.21.title%",
        "category": "DB Explorer",
        "icon": "$(graph)"
      },
      {
        "command": "dbExplorer.explainAnalyze",
        "title": "%commands.22.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.saveQuery",
        "title": "%commands.23.title%",
        "category": "DB Explorer",
        "icon": "$(save)"
      },
      {
        "command": "dbExplorer.openSaved",
        "title": "%commands.24.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.runSaved",
        "title": "%commands.25.title%",
        "category": "DB Explorer",
        "icon": "$(play)"
      },
      {
        "command": "dbExplorer.renameSaved",
        "title": "%commands.26.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.moveSaved",
        "title": "%commands.27.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.deleteSaved",
        "title": "%commands.28.title%",
        "category": "DB Explorer",
        "icon": "$(trash)"
      },
      {
        "command": "dbExplorer.renameSavedFolder",
        "title": "%commands.29.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.deleteSavedFolder",
        "title": "%commands.30.title%",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.compareSchemas",
        "title": "%commands.31.title%",
        "category": "DB Explorer",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbExplorer.addConnection",
          "when": "view == dbExplorer.connections",
          "group": "navigation@1"
        },
        {
          "command": "dbExplorer.refresh",
          "when": "view == dbExplorer.connections",
          "group": "navigation@2"
        },
        {
          "command": "dbExplorer.importConnections",
          "when": "view == dbExplorer.connections",
          "group": "1_connections@1"
        },
        {
          "command": "dbExplorer.exportConnections",
          "when": "view == dbExplorer.connections",
          "group": "1_connections@2"
        }
      ],
      "view/item/inline": [
        {
          "command": "dbExplorer.newQuery",
          "when": "view == dbExplorer.connections && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.previewTable",
          "when": "view == dbExplorer.connections && viewItem =~ /^(table|view)$/",
          "group": "inline@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dbExplorer.setGroup",
          "when": "view == dbExplorer.connections && viewItem == connection",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.renameGroup",
          "when": "view == dbExplorer.connections && viewItem == group",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.removeGroup",
          "when": "view == dbExplorer.connections && viewItem == group",
          "group": "3_manage@2"
        },
        {
          "command": "dbExplorer.previewTable",
          "when": "view == dbExplorer.connections && viewItem =~ /^(table|view)$/",
          "group": "1_query@1"
        },
        {
          "command": "dbExplorer.showStructure",
          "when": "view == dbExplorer.connections && viewItem =~ /^(table|view)$/",
          "group": "1_query@1.5"
        },
        {
          "command": "dbExplorer.showDiagram",
          "when": "view == dbExplorer.connections && viewItem == container",
          "group": "1_query@1"
        },
        {
          "command": "dbExplorer.newQuery",
          "when": "view == dbExplorer.connections && viewItem =~ /^(connection|container|table|view)$/",
          "group": "1_query@2"
        },
        {
          "command": "dbExplorer.copyName",
          "when": "view == dbExplorer.connections && viewItem =~ /^(container|table|view|column)$/",
          "group": "2_edit@1"
        },
        {
          "command": "dbExplorer.editConnection",
          "when": "view == dbExplorer.connections && viewItem == connection",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.removeConnection",
          "when": "view == dbExplorer.connections && viewItem == connection",
          "group": "3_manage@2"
        },
        {
          "command": "dbExplorer.runSaved",
          "when": "view == dbExplorer.saved && viewItem == savedQuery",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.runSaved",
          "when": "view == dbExplorer.saved && viewItem == savedQuery",
          "group": "1_run"
        },
        {
          "command": "dbExplorer.openSaved",
          "when": "view == dbExplorer.saved && viewItem == savedQuery",
          "group": "1_run"
        },
        {
          "command": "dbExplorer.renameSaved",
          "when": "view == dbExplorer.saved && viewItem == savedQuery",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.moveSaved",
          "when": "view == dbExplorer.saved && viewItem == savedQuery",
          "group": "3_manage@2"
        },
        {
          "command": "dbExplorer.deleteSaved",
          "when": "view == dbExplorer.saved && viewItem == savedQuery",
          "group": "3_manage@3"
        },
        {
          "command": "dbExplorer.renameSavedFolder",
          "when": "view == dbExplorer.saved && viewItem == savedFolder",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.deleteSavedFolder",
          "when": "view == dbExplorer.saved && viewItem == savedFolder",
          "group": "3_manage@2"
        },
        {
          "command": "dbExplorer.compareSchemas",
          "when": "view == dbExplorer.connections && viewItem == container",
          "group": "1_query@2"
        }
      ],
      "editor/title": [
        {
          "command": "dbExplorer.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        },
        {
          "command": "dbExplorer.history",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "dbExplorer.cancelQuery",
          "when": "editorLangId == sql && dbExplorer.queryRunning",
          "group": "navigation@0"
        },
        {
          "command": "dbExplorer.runStatement",
          "when": "editorLangId == sql",
          "group": "navigation"
        },
        {
          "command": "dbExplorer.explain",
          "when": "editorLangId == sql",
          "group": "navigation"
        },
        {
          "command": "dbExplorer.saveQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "dbExplorer.setGroup",
          "when": "false"
        },
        {
          "command": "dbExplorer.renameGroup",
          "when": "false"
        },
        {
          "command": "dbExplorer.removeGroup",
          "when": "false"
        },
        {
          "command": "dbExplorer.editConnection",
          "when": "false"
        },
        {
          "command": "dbExplorer.removeConnection",
          "when": "false"
        },
        {
          "command": "dbExplorer.previewTable",
          "when": "false"
        },
        {
          "command": "dbExplorer.showStructure",
          "when": "false"
        },
        {
          "command": "dbExplorer.showDiagram",
          "when": "false"
        },
        {
          "command": "dbExplorer.copyName",
          "when": "false"
        },
        {
          "command": "dbExplorer.runQuery",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.selectConnection",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.cancelQuery",
          "when": "dbExplorer.queryRunning"
        },
        {
          "command": "dbExplorer.runStatement",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.explain",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.explainAnalyze",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.openSaved",
          "when": "false"
        },
        {
          "command": "dbExplorer.runSaved",
          "when": "false"
        },
        {
          "command": "dbExplorer.renameSaved",
          "when": "false"
        },
        {
          "command": "dbExplorer.moveSaved",
          "when": "false"
        },
        {
          "command": "dbExplorer.deleteSaved",
          "when": "false"
        },
        {
          "command": "dbExplorer.renameSavedFolder",
          "when": "false"
        },
        {
          "command": "dbExplorer.deleteSavedFolder",
          "when": "false"
        },
        {
          "command": "dbExplorer.saveQuery",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.compareSchemas",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "dbExplorer.runStatement",
          "when": "editorLangId == sql",
          "group": "1_dbx@1"
        },
        {
          "command": "dbExplorer.explain",
          "when": "editorLangId == sql",
          "group": "1_dbx@2"
        },
        {
          "command": "dbExplorer.saveQuery",
          "when": "editorLangId == sql",
          "group": "1_dbx@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbExplorer.runQuery",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "dbExplorer.runStatement",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "dbExplorer.explain",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dbExplorer.previewLimit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "%configuration.properties.dbExplorer.previewLimit.description%"
        },
        "dbExplorer.maxRows": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "%configuration.properties.dbExplorer.maxRows.description%"
        },
        "dbExplorer.showSystemSchemas": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.properties.dbExplorer.showSystemSchemas.description%"
        },
        "dbExplorer.csvSeparator": {
          "type": "string",
          "enum": [
            ",",
            ";",
            "tab"
          ],
          "default": ",",
          "description": "%configuration.properties.dbExplorer.csvSeparator.description%"
        },
        "dbExplorer.confirmDangerous": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.dbExplorer.confirmDangerous.description%"
        },
        "dbExplorer.confirmOnProduction": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.dbExplorer.confirmOnProduction.description%"
        },
        "dbExplorer.promptParameters": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.properties.dbExplorer.promptParameters.description%"
        }
      }
    }
  },
  "scripts": {
    "copy:wasm": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','dist/sql-wasm.wasm')\"",
    "typecheck": "tsc --noEmit -p ./",
    "build": "npm run typecheck && npm run copy:wasm && esbuild src/extension.ts src/sqliteWorker.ts --bundle --outdir=dist --external:vscode --external:pg-native --external:cpu-features --external:*.node --format=cjs --platform=node --target=node18 --sourcemap",
    "build:prod": "npm run typecheck && npm run copy:wasm && esbuild src/extension.ts src/sqliteWorker.ts --bundle --outdir=dist --external:vscode --external:pg-native --external:cpu-features --external:*.node --format=cjs --platform=node --target=node18 --minify",
    "watch": "esbuild src/extension.ts src/sqliteWorker.ts --bundle --outdir=dist --external:vscode --external:pg-native --external:cpu-features --external:*.node --format=cjs --platform=node --target=node18 --sourcemap --watch",
    "package": "npm run build:prod && vsce package --no-dependencies",
    "test": "node test/run.js",
    "test:unit": "node test/build.js && node --test test/unit.test.js test/tunnel.test.js test/form.test.js test/sqlite.test.js test/er.test.js test/structure.test.js test/refresh.test.js test/connections.test.js test/editor.test.js test/saved.test.js test/schemadiff.test.js test/i18n.test.js",
    "test:integration": "npm run build && node test/integration/runTest.js"
  },
  "dependencies": {
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "sql.js": "^1.14.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.0",
    "@types/pg": "^8.11.0",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^24.1.3",
    "mocha": "^12.0.3",
    "typescript": "^5.5.0"
  }
}
