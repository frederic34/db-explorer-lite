{
  "name": "db-explorer-lite",
  "displayName": "DB Explorer Lite",
  "description": "Se connecter à MySQL/MariaDB, PostgreSQL ou SQLite, parcourir les tables, consulter et exporter les données, exécuter des requêtes SQL, afficher la structure et le diagramme des relations.",
  "version": "0.7.0",
  "publisher": "local",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/frederic34/db-explorer-lite.git"
  },
  "bugs": {
    "url": "https://github.com/frederic34/db-explorer-lite/issues"
  },
  "homepage": "https://github.com/frederic34/db-explorer-lite#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sql",
    "mysql",
    "mariadb",
    "postgresql",
    "sqlite",
    "database"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbExplorer",
          "title": "DB Explorer",
          "icon": "resources/database.svg"
        }
      ]
    },
    "views": {
      "dbExplorer": [
        {
          "id": "dbExplorer.connections",
          "name": "Connexions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbExplorer.connections",
        "contents": "Aucune connexion configurée.\n[Ajouter une connexion](command:dbExplorer.addConnection)\n[Importer des connexions](command:dbExplorer.importConnections)"
      }
    ],
    "commands": [
      {
        "command": "dbExplorer.addConnection",
        "title": "Ajouter une connexion",
        "category": "DB Explorer",
        "icon": "$(add)"
      },
      {
        "command": "dbExplorer.editConnection",
        "title": "Modifier la connexion",
        "category": "DB Explorer",
        "icon": "$(edit)"
      },
      {
        "command": "dbExplorer.removeConnection",
        "title": "Supprimer la connexion",
        "category": "DB Explorer",
        "icon": "$(trash)"
      },
      {
        "command": "dbExplorer.refresh",
        "title": "Actualiser",
        "category": "DB Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "dbExplorer.newQuery",
        "title": "Nouvelle requête SQL",
        "category": "DB Explorer",
        "icon": "$(new-file)"
      },
      {
        "command": "dbExplorer.runQuery",
        "title": "Exécuter la requête",
        "category": "DB Explorer",
        "icon": "$(play)"
      },
      {
        "command": "dbExplorer.previewTable",
        "title": "Afficher les données",
        "category": "DB Explorer",
        "icon": "$(open-preview)"
      },
      {
        "command": "dbExplorer.showStructure",
        "title": "Afficher la structure (index, contraintes, DDL)",
        "category": "DB Explorer",
        "icon": "$(symbol-structure)"
      },
      {
        "command": "dbExplorer.showDiagram",
        "title": "Diagramme des relations",
        "category": "DB Explorer",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dbExplorer.setGroup",
        "title": "Ranger dans un groupe…",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.renameGroup",
        "title": "Renommer le groupe",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.removeGroup",
        "title": "Supprimer le groupe",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.exportConnections",
        "title": "Exporter les connexions (sans mots de passe)",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.importConnections",
        "title": "Importer des connexions (JSON, .pgpass, .my.cnf, pg_service)",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.selectConnection",
        "title": "Choisir la connexion de cet éditeur",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.copyName",
        "title": "Copier le nom",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.history",
        "title": "Historique des requêtes",
        "category": "DB Explorer",
        "icon": "$(history)"
      },
      {
        "command": "dbExplorer.clearHistory",
        "title": "Effacer l'historique des requêtes",
        "category": "DB Explorer"
      },
      {
        "command": "dbExplorer.cancelQuery",
        "title": "Annuler la requête en cours",
        "category": "DB Explorer",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dbExplorer.forgetSshHosts",
        "title": "Oublier les serveurs SSH approuvés",
        "category": "DB Explorer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbExplorer.addConnection",
          "when": "view == dbExplorer.connections",
          "group": "navigation@1"
        },
        {
          "command": "dbExplorer.refresh",
          "when": "view == dbExplorer.connections",
          "group": "navigation@2"
        },
        {
          "command": "dbExplorer.importConnections",
          "when": "view == dbExplorer.connections",
          "group": "1_connections@1"
        },
        {
          "command": "dbExplorer.exportConnections",
          "when": "view == dbExplorer.connections",
          "group": "1_connections@2"
        }
      ],
      "view/item/inline": [
        {
          "command": "dbExplorer.newQuery",
          "when": "view == dbExplorer.connections && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "dbExplorer.previewTable",
          "when": "view == dbExplorer.connections && viewItem =~ /^(table|view)$/",
          "group": "inline@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dbExplorer.setGroup",
          "when": "view == dbExplorer.connections && viewItem == connection",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.renameGroup",
          "when": "view == dbExplorer.connections && viewItem == group",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.removeGroup",
          "when": "view == dbExplorer.connections && viewItem == group",
          "group": "3_manage@2"
        },
        {
          "command": "dbExplorer.previewTable",
          "when": "view == dbExplorer.connections && viewItem =~ /^(table|view)$/",
          "group": "1_query@1"
        },
        {
          "command": "dbExplorer.showStructure",
          "when": "view == dbExplorer.connections && viewItem =~ /^(table|view)$/",
          "group": "1_query@1.5"
        },
        {
          "command": "dbExplorer.showDiagram",
          "when": "view == dbExplorer.connections && viewItem == container",
          "group": "1_query@1"
        },
        {
          "command": "dbExplorer.newQuery",
          "when": "view == dbExplorer.connections && viewItem =~ /^(connection|container|table|view)$/",
          "group": "1_query@2"
        },
        {
          "command": "dbExplorer.copyName",
          "when": "view == dbExplorer.connections && viewItem =~ /^(container|table|view|column)$/",
          "group": "2_edit@1"
        },
        {
          "command": "dbExplorer.editConnection",
          "when": "view == dbExplorer.connections && viewItem == connection",
          "group": "3_manage@1"
        },
        {
          "command": "dbExplorer.removeConnection",
          "when": "view == dbExplorer.connections && viewItem == connection",
          "group": "3_manage@2"
        }
      ],
      "editor/title": [
        {
          "command": "dbExplorer.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation"
        },
        {
          "command": "dbExplorer.history",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "dbExplorer.cancelQuery",
          "when": "editorLangId == sql && dbExplorer.queryRunning",
          "group": "navigation@0"
        }
      ],
      "commandPalette": [
        {
          "command": "dbExplorer.setGroup",
          "when": "false"
        },
        {
          "command": "dbExplorer.renameGroup",
          "when": "false"
        },
        {
          "command": "dbExplorer.removeGroup",
          "when": "false"
        },
        {
          "command": "dbExplorer.editConnection",
          "when": "false"
        },
        {
          "command": "dbExplorer.removeConnection",
          "when": "false"
        },
        {
          "command": "dbExplorer.previewTable",
          "when": "false"
        },
        {
          "command": "dbExplorer.showStructure",
          "when": "false"
        },
        {
          "command": "dbExplorer.showDiagram",
          "when": "false"
        },
        {
          "command": "dbExplorer.copyName",
          "when": "false"
        },
        {
          "command": "dbExplorer.runQuery",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.selectConnection",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbExplorer.cancelQuery",
          "when": "dbExplorer.queryRunning"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbExplorer.runQuery",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == sql"
      }
    ],
    "configuration": {
      "title": "DB Explorer Lite",
      "properties": {
        "dbExplorer.previewLimit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "Lignes par page au départ dans l'aperçu d'une table (modifiable dans l'aperçu, 1 à 1000)."
        },
        "dbExplorer.maxRows": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Nombre maximum de lignes conservées et affichées pour un résultat de requête (le reste est ignoré)."
        },
        "dbExplorer.showSystemSchemas": {
          "type": "boolean",
          "default": false,
          "description": "Afficher les bases / schémas système (information_schema, mysql, pg_catalog…)."
        },
        "dbExplorer.csvSeparator": {
          "type": "string",
          "enum": [
            ",",
            ";",
            "tab"
          ],
          "default": ",",
          "description": "Séparateur utilisé pour l'export CSV (« ; » est souvent préférable pour Excel en français)."
        },
        "dbExplorer.confirmDangerous": {
          "type": "boolean",
          "default": true,
          "description": "Demander confirmation avant d'exécuter UPDATE / DELETE sans WHERE, DROP, TRUNCATE ou ALTER … DROP."
        },
        "dbExplorer.confirmOnProduction": {
          "type": "boolean",
          "default": true,
          "description": "Sur une connexion marquée « production », demander confirmation avant toute écriture (éditeur SQL et grille)."
        }
      }
    }
  },
  "scripts": {
    "copy:wasm": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','dist/sql-wasm.wasm')\"",
    "typecheck": "tsc --noEmit -p ./",
    "build": "npm run typecheck && npm run copy:wasm && esbuild src/extension.ts src/sqliteWorker.ts --bundle --outdir=dist --external:vscode --external:pg-native --external:cpu-features --external:*.node --format=cjs --platform=node --target=node18 --sourcemap",
    "build:prod": "npm run typecheck && npm run copy:wasm && esbuild src/extension.ts src/sqliteWorker.ts --bundle --outdir=dist --external:vscode --external:pg-native --external:cpu-features --external:*.node --format=cjs --platform=node --target=node18 --minify",
    "watch": "esbuild src/extension.ts src/sqliteWorker.ts --bundle --outdir=dist --external:vscode --external:pg-native --external:cpu-features --external:*.node --format=cjs --platform=node --target=node18 --sourcemap --watch",
    "package": "npm run build:prod && vsce package --no-dependencies",
    "test": "node test/run.js",
    "test:unit": "node test/build.js && node --test test/unit.test.js test/tunnel.test.js test/form.test.js test/sqlite.test.js test/er.test.js test/structure.test.js test/refresh.test.js test/connections.test.js"
  },
  "dependencies": {
    "mysql2": "^3.11.0",
    "pg": "^8.12.0",
    "sql.js": "^1.14.2",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/pg": "^8.11.0",
    "@types/sql.js": "^1.4.11",
    "@types/ssh2": "^1.15.6",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.0"
  }
}
